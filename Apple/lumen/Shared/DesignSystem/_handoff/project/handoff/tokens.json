{
  "$schema": "https://design-tokens.org/schema",
  "meta": {
    "name": "Lumen Morning",
    "version": "0.1.0",
    "direction": "A — Sable & papier",
    "platform": "iOS 17+",
    "updated": "2026-04-26"
  },
  "color": {
    "dark": {
      "bg": {
        "primary":   { "value": "#0F0D0B", "description": "Noir chaud, presque marron très foncé" },
        "secondary": { "value": "#1A1714", "description": "Surface élevée (cards, sheets)" },
        "tertiary":  { "value": "#2A241F", "description": "Hover / pressed" }
      },
      "text": {
        "primary":   { "value": "#F5EFE6" },
        "secondary": { "value": "#9A8D7D" },
        "tertiary":  { "value": "#6A5E51" }
      },
      "accent": {
        "default": { "value": "#E8C39E", "description": "Sable chaud" },
        "muted":   { "value": "#A68566" }
      },
      "semantic": {
        "success": { "value": "#7FA58A" },
        "warning": { "value": "#D4A853" },
        "error":   { "value": "#C85A54" }
      },
      "divider": { "value": "#2E2822" }
    },
    "light": {
      "bg": {
        "primary":   { "value": "#FAF6EF", "description": "Crème" },
        "secondary": { "value": "#FFFFFF" },
        "tertiary":  { "value": "#F2ECDE" }
      },
      "text": {
        "primary":   { "value": "#1F1A14" },
        "secondary": { "value": "#6B5F50" },
        "tertiary":  { "value": "#A89A88" }
      },
      "accent": {
        "default": { "value": "#A67C52", "description": "Terracotta" },
        "muted":   { "value": "#C9A882" }
      },
      "semantic": {
        "success": { "value": "#5A7A65" },
        "warning": { "value": "#B08040" },
        "error":   { "value": "#A04540" }
      },
      "divider": { "value": "#E5DDC9" }
    }
  },
  "typography": {
    "family": {
      "serif":     { "value": "New York", "fallback": ["Charter", "Iowan Old Style", "Georgia", "serif"] },
      "sansSerif": { "value": "SF Pro",   "fallback": ["-apple-system", "BlinkMacSystemFont", "Helvetica Neue", "sans-serif"] },
      "mono":      { "value": "SF Mono",  "fallback": ["ui-monospace", "Menlo", "monospace"] }
    },
    "scale": {
      "display":   { "size": 48, "weight": "Regular",  "lineHeight": 1.1,  "family": "serif",     "tracking": -0.015, "usage": "Citation hero, quote timer" },
      "title1":    { "size": 32, "weight": "Semibold", "lineHeight": 1.15, "family": "serif",     "tracking": -0.01,  "usage": "Titre écran principal" },
      "title2":    { "size": 24, "weight": "Semibold", "lineHeight": 1.2,  "family": "serif",     "tracking": -0.005, "usage": "Sous-titre" },
      "title3":    { "size": 20, "weight": "Medium",   "lineHeight": 1.25, "family": "sansSerif", "tracking": 0,      "usage": "Card header" },
      "body":      { "size": 17, "weight": "Regular",  "lineHeight": 1.5,  "family": "sansSerif", "tracking": 0,      "usage": "Texte courant" },
      "bodyBold":  { "size": 17, "weight": "Semibold", "lineHeight": 1.5,  "family": "sansSerif", "tracking": 0,      "usage": "Emphasis dans texte" },
      "callout":   { "size": 15, "weight": "Regular",  "lineHeight": 1.45, "family": "sansSerif", "tracking": 0,      "usage": "Secondary text" },
      "footnote":  { "size": 13, "weight": "Regular",  "lineHeight": 1.4,  "family": "sansSerif", "tracking": 0.02,   "usage": "Metadata" },
      "caption":   { "size": 11, "weight": "Regular",  "lineHeight": 1.3,  "family": "sansSerif", "tracking": 0.18,   "usage": "Tiny label, eyebrow" }
    },
    "dynamicType": true
  },
  "spacing": {
    "xs":   { "value": 4 },
    "s":    { "value": 8 },
    "m":    { "value": 16 },
    "l":    { "value": 24 },
    "xl":   { "value": 32 },
    "xxl":  { "value": 48 },
    "huge": { "value": 64 }
  },
  "radius": {
    "s":  { "value": 8,  "usage": "Chips, tags" },
    "m":  { "value": 14, "usage": "Buttons, inputs" },
    "l":  { "value": 20, "usage": "Cards dashboard, modals" },
    "xl": { "value": 28, "usage": "Hero cards, quote container" },
    "round": { "value": 999, "usage": "Pills, breathing circle" }
  },
  "shadow": {
    "soft": { "value": "0px 2px 8px rgba(0, 0, 0, 0.04)",  "applies": "light only" },
    "card": { "value": "0px 4px 16px rgba(0, 0, 0, 0.06)", "applies": "light only" }
  },
  "motion": {
    "duration": {
      "instant": 100,
      "quick":   200,
      "smooth":  300,
      "slow":    500,
      "breath":  4000
    },
    "easing": {
      "standard":   "ease-in-out",
      "decelerate": "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0.0, 1.0, 1.0)",
      "breath":     "ease-in-out"
    },
    "haptics": {
      "alarmSilence":  ".medium",
      "timerEnd":      ".soft",
      "synthesisReady": ".success"
    },
    "rules": [
      "Reduce Motion respected → fallback crossfade",
      "No iOS spring (.spring()) — use .easeInOut",
      "60 FPS minimum or remove animation",
      "Animation = decision, not default"
    ]
  },
  "accessibility": {
    "contrast": {
      "minNormalText": 4.5,
      "minLargeText": 3.0
    },
    "dynamicType": "scales up to AccessibilityXXXL",
    "reduceMotion": "all signature motion falls back to crossfade",
    "reduceTransparency": "surfaces become fully opaque (no glass)"
  }
}
